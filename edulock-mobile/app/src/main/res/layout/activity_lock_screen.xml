<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLockScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:background="#FFCDD2">  <!-- background merah agak terang untuk indikasi locked -->

    <TextView
        android:id="@+id/tvLockMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PERANGKAT TERKUNCI"
        android:textSize="22sp"
        android:textColor="#B71C1C"
        android:textStyle="bold"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:padding="24dp"/>

    <Button
        android:id="@+id/btnOpenSchoolApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BUKA APLIKASI SEKOLAH"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="100dp"
        android:backgroundTint="#1976D2"
        android:textColor="#FFFFFF"
        android:visibility="visible"/>

    <Button
        android:id="@+id/btnAdminUnlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Buka Kunci Admin"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="32dp"
        android:backgroundTint="#D32F2F"
        android:textColor="#FFFFFF"
        android:visibility="gone"/>

</RelativeLayout>
