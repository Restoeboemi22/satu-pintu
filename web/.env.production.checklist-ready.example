# Salin file ini menjadi `.env.local` saat menyiapkan environment production.
# Arsitektur final:
# - Hosting + GAS  : satu-pintu-gas-dev
# - EduLock backend: satu-pintu-edulock-dev

############################################
# 1) HOSTING UTAMA / PORTALKITA WEB
# Sumber: Firebase Console GAS -> Project settings -> General -> Your apps
############################################
NEXT_PUBLIC_HOSTING_ACTIVE_HOST=PASTE_PRODUCTION_WEB_URL
NEXT_PUBLIC_HOSTING_RETIRED_HOSTS=
NEXT_PUBLIC_HOSTING_PROJECT_ID=satu-pintu-gas-dev

############################################
# 2) CLIENT BOUNDARY GAS / PORTALKITA
# Sumber: Firebase Console GAS -> Project settings -> General -> Your apps -> SDK setup and configuration
############################################
NEXT_PUBLIC_FIREBASE_GAS_API_KEY=PASTE_FROM_GAS_CONSOLE_API_KEY
NEXT_PUBLIC_FIREBASE_GAS_AUTH_DOMAIN=satu-pintu-gas-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_GAS_DATABASE_URL=https://satu-pintu-gas-dev-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_GAS_PROJECT_ID=satu-pintu-gas-dev
NEXT_PUBLIC_FIREBASE_GAS_STORAGE_BUCKET=satu-pintu-gas-dev.firebasestorage.app
NEXT_PUBLIC_FIREBASE_GAS_MESSAGING_SENDER_ID=PASTE_FROM_GAS_CONSOLE_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_GAS_APP_ID=PASTE_FROM_GAS_CONSOLE_APP_ID

############################################
# 3) CLIENT BOUNDARY EDULOCK
# Sumber: Firebase Console EduLock -> Project settings -> General -> Your apps -> SDK setup and configuration
############################################
NEXT_PUBLIC_FIREBASE_EDULOCK_APP_NAME=edulock
NEXT_PUBLIC_FIREBASE_EDULOCK_API_KEY=PASTE_FROM_EDULOCK_CONSOLE_API_KEY
NEXT_PUBLIC_FIREBASE_EDULOCK_AUTH_DOMAIN=satu-pintu-edulock-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_EDULOCK_DATABASE_URL=https://satu-pintu-edulock-dev-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_EDULOCK_PROJECT_ID=satu-pintu-edulock-dev
NEXT_PUBLIC_FIREBASE_EDULOCK_STORAGE_BUCKET=satu-pintu-edulock-dev.firebasestorage.app
NEXT_PUBLIC_FIREBASE_EDULOCK_MESSAGING_SENDER_ID=PASTE_FROM_EDULOCK_CONSOLE_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_EDULOCK_APP_ID=PASTE_FROM_EDULOCK_CONSOLE_APP_ID

############################################
# 4) SESSION PORTAL WEB
# Sumber: generate sendiri, jangan ambil dari Firebase Console
# Rekomendasi PowerShell:
# [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
############################################
PORTAL_SESSION_SECRET=PASTE_RANDOM_LONG_SECRET

############################################
# 5) SERVER BOUNDARY GAS
# Sumber: Firebase Console GAS -> Project settings -> Service accounts -> Generate new private key
# Ubah ke satu baris dengan:
# node scripts/print-service-account-env.js GAS path/to/gas-service-account.json
############################################
FIREBASE_ADMIN_GAS_SERVICE_ACCOUNT_JSON=PASTE_MINIFIED_GAS_SERVICE_ACCOUNT_JSON

############################################
# 6) SERVER BOUNDARY EDULOCK
# Sumber: Firebase Console EduLock -> Project settings -> Service accounts -> Generate new private key
# Ubah ke satu baris dengan:
# node scripts/print-service-account-env.js EDULOCK path/to/edulock-service-account.json
############################################
FIREBASE_ADMIN_EDULOCK_SERVICE_ACCOUNT_JSON=PASTE_MINIFIED_EDULOCK_SERVICE_ACCOUNT_JSON
